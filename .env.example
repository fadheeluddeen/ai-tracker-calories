# Server
PORT=3020

# Postgres
DATABASE_URL=postgres://plate_log:plate_log@localhost:5432/plate_log

# Gemini (Google AI Studio, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Drive nightly backup (OAuth device flow) — run `npm run drive:auth`
# once to authorize. See README for how to create the OAuth client (must be
# "TVs and Limited Input devices" type).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Drive folder ID to upload backups into. Leave blank to upload
# into the root of your Drive instead.
GOOGLE_DRIVE_FOLDER_ID=

# Only needed if you also want the old service-account-based real-time
# backup attempt on each upload (server/services/drive.js) — unused by the
# nightly OAuth backup above.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
