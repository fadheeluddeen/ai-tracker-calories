# Server
PORT=3020

# Postgres
DATABASE_URL=postgres://plate_log:plate_log@localhost:5432/plate_log

# Gemini (Google AI Studio, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Drive backup (service account) — see README for setup steps
# Path to the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
# ID of the Drive folder (owned by a real Google account, shared with the
# service account's client_email as Editor) that backups get uploaded into
GOOGLE_DRIVE_FOLDER_ID=
