{
  "name": "plate-log",
  "version": "1.0.0",
  "description": "Photo-based calorie tracker: snap a plate, get calories/macros via Gemini.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build:client": "npm install --prefix reference-ui && npm run build --prefix reference-ui",
    "migrate": "node server/migrate.js",
    "drive:auth": "node server/scripts/driveAuthSetup.js",
    "backup:drive": "node server/scripts/driveBackup.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart plate-log",
    "pm2:logs": "pm2 logs plate-log"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^178.1.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  }
}
